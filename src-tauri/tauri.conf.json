{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "telly",
  "version": "../package.json",
  "identifier": "io.github.tellyteam.telly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "telly",
        "width": 1320,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#151a22",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* https://api.github.com",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Entertainment",
    "shortDescription": "A small, fast IPTV player",
    "longDescription": "telly is a small, fast IPTV player. Bring your own provider (Xtream Codes or an M3U playlist).",
    "copyright": "telly contributors, GPL-3.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "externalBin": ["binaries/ffmpeg"]
  }
}
